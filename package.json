        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.12.0",
  "overrides": {
    "esbuild": "^0.28.1",
    "piscina": "^5.2.0",
    "@babel/core": "^7.29.6"
  },
  "dependencies": {
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/platform-browser": "^22.0.6",
    "@angular/router": "^22.0.6",
    "@bluehalo/ngx-leaflet": "^22.0.0",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "file-saver": "^2.0.5",
    "leaflet": "^1.9.4",
    "ngx-echarts": "^22.0.0",
    "ngx-pk-ui": "^3.0.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
