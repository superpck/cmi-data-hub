{
  "name": "cmi-data-hub",
  "version": "5.0.1",
  "subVersion": "2026.07.10-1",
  "description": "ระบบข้อมูล CMI กลางกระทรวงสาธารณสุข",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4404 -o",
    "build": "rm -rf dist && ng build",
