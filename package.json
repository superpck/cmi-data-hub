    "@tailwindcss/postcss": "^4.3.2",
    "@types/file-saver": "^2.0.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
